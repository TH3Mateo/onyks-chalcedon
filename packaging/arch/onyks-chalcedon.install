post_install() {
    if command -v systemctl >/dev/null 2>&1 && systemctl cat tailscaled.service >/dev/null 2>&1; then
        systemctl enable --now tailscaled || true
    fi

    # Register the PostgreSQL ODBC driver shipped with this package, unless one is registered already.
    if ! odbcinst -q -d 2>/dev/null | grep -qi postgresql; then
        odbcinst -i -d -f /usr/share/onyks-chalcedon/psqlodbc.template || \
            echo ">>> ONYKS Chalcedon: could not register the PostgreSQL ODBC driver (/usr/lib/onyks-chalcedon/psqlodbc/lib/psqlodbcw.so)."
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Unregister the driver only if it is ours.
    if grep -qs '/usr/lib/onyks-chalcedon/psqlodbc/' /etc/odbcinst.ini; then
        odbcinst -u -d -n "PostgreSQL Unicode" || true
    fi
}
